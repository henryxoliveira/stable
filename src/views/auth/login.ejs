<%- include('../partials/header', { title: 'Log in' }) %>
<section class="card narrow">
  <h1>Log in</h1>
  <% if (errors._form) { %><p class="alert" role="alert"><%= errors._form %></p><% } %>
  <form method="post" action="/login" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" autocomplete="username" required value="<%= values.email || '' %>">
    <%- include('../partials/field-error', { field: 'email' }) %>

    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required>
    <%- include('../partials/field-error', { field: 'password' }) %>

    <button type="submit" class="btn">Log in</button>
  </form>
  <p class="muted">New here? <a href="/register">Create an account</a>.</p>
</section>
<%- include('../partials/footer') %>
