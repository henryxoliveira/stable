<%- include('../partials/header', { title: 'Register' }) %>
<section class="card narrow">
  <h1>Create your account</h1>
  <% if (errors._form) { %><p class="alert" role="alert"><%= errors._form %></p><% } %>
  <form method="post" action="/register" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">

    <fieldset>
      <legend>I am a…</legend>
      <label class="radio"><input type="radio" name="role" value="STUDENT" <%= values.role !== 'LANDLORD' ? 'checked' : '' %>>
        Student (requires an @<%= locals.domain || 'scu.edu' %> email)</label>
      <label class="radio"><input type="radio" name="role" value="LANDLORD" <%= values.role === 'LANDLORD' ? 'checked' : '' %>>
        Landlord / property manager (approved by a Stable admin before you can publish)</label>
      <%- include('../partials/field-error', { field: 'role' }) %>
    </fieldset>

    <label for="email">Email</label>
    <input id="email" name="email" type="email" autocomplete="username" required value="<%= values.email || '' %>">
    <%- include('../partials/field-error', { field: 'email' }) %>

    <label for="password">Password (at least 10 characters)</label>
    <input id="password" name="password" type="password" autocomplete="new-password" minlength="10" required>
    <%- include('../partials/field-error', { field: 'password' }) %>

    <button type="submit" class="btn">Create account</button>
  </form>
  <p class="muted">Already have an account? <a href="/login">Log in</a>.</p>
</section>
<%- include('../partials/footer') %>
