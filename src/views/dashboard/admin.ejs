<%- include('../partials/header', { title: 'Admin dashboard' }) %>
<h1>Stable admin</h1>
<p><a class="btn" href="/admin/accounts">Accounts</a>
  <% if (pendingLandlords > 0) { %>
    <span class="badge"><%= pendingLandlords %> <%= pendingLandlords === 1 ? 'landlord' : 'landlords' %> waiting for approval</span>
  <% } else { %>
    <span class="muted">No landlords waiting for approval.</span>
  <% } %>
</p>
<p>Coming soon:</p>
<ul class="todo">
  <li>Review listings: approve, or return with comments</li>
  <li>On-campus buildings and rooms</li>
  <li>Oversight: all applications and audit events</li>
</ul>
<%- include('../partials/footer') %>
