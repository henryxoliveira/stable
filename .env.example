# Copy to .env (gitignored) and fill in YOUR values. Never commit .env.
# Placeholders only. No real credentials belong in this file.

# development | test | production
NODE_ENV=development
# Cloud Run sets PORT automatically; 8080 locally.
PORT=8080

# Neon Postgres (Dashboard → Connection string, "Pooled" is fine). Must include sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/stable?sslmode=require
# A SEPARATE database/branch for tests. Tests TRUNCATE tables here. Never point at prod.
DATABASE_URL_TEST=postgresql://USER:PASSWORD@YOUR-NEON-TEST-BRANCH-HOST.neon.tech/stable_test?sslmode=require

# Signs session cookies. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Google Cloud Storage bucket for floor plans and photos.
GCS_BUCKET=your-stable-uploads-bucket
# LOCAL ONLY: path to a service-account key file OUTSIDE this repo (e.g. ~/keys/stable-dev-key.json).
# On Cloud Run leave unset; the service's own identity is used.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/stable-dev-key.json

# First admin account, used ONLY by `npm run seed:admin`.
ADMIN_EMAIL=housing-admin@scu.edu
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Students must register with an email at this domain.
ALLOWED_STUDENT_EMAIL_DOMAIN=scu.edu
