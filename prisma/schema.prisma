// Stable database schema (Neon Postgres via Prisma).
//
// RULES (see CLAUDE.md):
//  - Every change ships as a NEW migration: `npm run db:migrate -- --name <what_changed>`.
//  - Production only ever runs `prisma migrate deploy`. Never `migrate reset` or `db push`.
//  - Table/column names are snake_case in Postgres (@@map / @map) so raw SQL stays readable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  LANDLORD
  ADMIN
}

/// ACTIVE: can use everything their role allows.
/// PENDING: landlord awaiting admin approval; can log in but cannot publish.
/// SUSPENDED: cannot log in (existing sessions are dropped on next request).
enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique // stored lowercased
  passwordHash String     @map("password_hash") // argon2id; never selected into views or JSON
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  ownedGroups      RoommateGroup[]
  groupMemberships GroupMember[]
  sentInvitations  GroupInvitation[]
  groupEvents      GroupEvent[]

  @@map("users")
}

/// Server-side sessions, owned by connect-pg-simple (express-session store).
/// Declared here so Prisma migrations create it and never try to drop it.
/// Do not query or change this table from application code.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// ---------------------------------------------------------------------------
// Roommate groups (roadmap B1). Logic lives in src/services/group.service.js.
// ---------------------------------------------------------------------------

/// ACTIVE: normal. DISBANDED: the sole owner left; hidden from everyone but admins.
enum GroupStatus {
  ACTIVE
  DISBANDED
}

/// An invitation is tied to an EMAIL, so people can be invited before they register.
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum GroupEventType {
  CREATED
  INVITED
  INVITE_CANCELLED
  INVITE_ACCEPTED
  INVITE_DECLINED
  OWNERSHIP_TRANSFERRED
  MEMBER_LEFT
  DISBANDED
}

/// A roommate group for one term (e.g. FALL-2027).
model RoommateGroup {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  term      String // "FALL-2027", validated by zod
  ownerId   String      @map("owner_id") @db.Uuid
  status    GroupStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  owner       User              @relation(fields: [ownerId], references: [id])
  members     GroupMember[]
  invitations GroupInvitation[]
  events      GroupEvent[]

  @@index([term])
  @@map("roommate_groups")
}

/// Accepted members only. The row is DELETED when a member leaves
/// (history stays in group_events).
model GroupMember {
  id       String   @id @default(uuid()) @db.Uuid
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  /// Copied from the group so the database itself can enforce
  /// "one group per student per term" with the unique index below.
  term     String
  joinedAt DateTime @default(now()) @map("joined_at")

  group RoommateGroup @relation(fields: [groupId], references: [id])
  user  User          @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@unique([userId, term])
  @@map("group_members")
}

/// Pending/answered invitations, matched to accounts by email when read.
/// One row per (group, email): re-inviting resets the row to PENDING.
model GroupInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  groupId     String           @map("group_id") @db.Uuid
  email       String // lowercased
  status      InvitationStatus @default(PENDING)
  invitedById String           @map("invited_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  respondedAt DateTime?        @map("responded_at")

  group     RoommateGroup @relation(fields: [groupId], references: [id])
  invitedBy User          @relation(fields: [invitedById], references: [id])

  @@unique([groupId, email])
  @@index([email, status])
  @@map("group_invitations")
}

/// Append-only audit log: who did what to a group, and when.
model GroupEvent {
  id        String         @id @default(uuid()) @db.Uuid
  groupId   String         @map("group_id") @db.Uuid
  actorId   String         @map("actor_id") @db.Uuid
  type      GroupEventType
  detail    Json? // e.g. { "email": "..." } or { "fromUserId": "...", "toUserId": "..." }
  createdAt DateTime       @default(now()) @map("created_at")

  group RoommateGroup @relation(fields: [groupId], references: [id])
  actor User          @relation(fields: [actorId], references: [id])

  @@index([groupId, createdAt])
  @@map("group_events")
}
