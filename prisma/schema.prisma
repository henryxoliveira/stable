// Stable database schema (Neon Postgres via Prisma).
//
// RULES (see CLAUDE.md):
//  - Every change ships as a NEW migration: `npm run db:migrate -- --name <what_changed>`.
//  - Production only ever runs `prisma migrate deploy`. Never `migrate reset` or `db push`.
//  - Table/column names are snake_case in Postgres (@@map / @map) so raw SQL stays readable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  LANDLORD
  ADMIN
}

/// ACTIVE: can use everything their role allows.
/// PENDING: landlord awaiting admin approval; can log in but cannot publish.
/// SUSPENDED: cannot log in (existing sessions are dropped on next request).
enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique // stored lowercased
  passwordHash String     @map("password_hash") // argon2id; never selected into views or JSON
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  ownedGroups       RoommateGroup[]
  groupMemberships  GroupMember[]
  properties        Property[]
  sentInvitations   GroupInvitation[]
  groupEvents       GroupEvent[]
  costEstimates     CostEstimate[]
  applicationEvents ApplicationEvent[]
  notifications     Notification[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Properties, units, floor plans (roadmap A2). Logic lives in
// src/services/property.service.js. Landlords own properties; units and floor
// plans belong to the property's owner. Money is integer cents.
// CHECK constraints (ranges, cents >= 0) are added in the migration SQL.
// ---------------------------------------------------------------------------

/// AVAILABLE until a group's offer is accepted (roadmap B5 sets LEASED).
enum UnitStatus {
  AVAILABLE
  LEASED
}

/// A building or house a landlord rents out.
model Property {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  name        String
  address     String // street address, e.g. "1234 Franklin St"
  city        String
  state       String   @default("CA") // two letters
  postalCode  String   @map("postal_code")
  /// Optional for now; the map (A5) and distance filters use them when set.
  latitude    Float?
  longitude   Float?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner User   @relation(fields: [ownerId], references: [id])
  units Unit[]

  @@index([ownerId])
  @@map("properties")
}

/// One rentable unit in a property (an apartment, or a whole house).
model Unit {
  id             String     @id @default(uuid()) @db.Uuid
  propertyId     String     @map("property_id") @db.Uuid
  label          String // "Unit 2B", unique within the property
  bedrooms       Int // 0 = studio
  /// How many people the unit fits (a roommate group must be this size or smaller).
  beds           Int
  bathrooms      Float // in steps of 0.5
  squareFeet     Int?       @map("square_feet")
  rentCents      Int        @map("rent_cents") // per month, whole unit
  utilitiesCents Int        @default(0) @map("utilities_cents") // per month
  parkingCents   Int        @default(0) @map("parking_cents") // per month
  status         UnitStatus @default(AVAILABLE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  property     Property      @relation(fields: [propertyId], references: [id])
  floorPlans   FloorPlan[]
  applications Application[]

  @@unique([propertyId, label])
  @@map("units")
}

/// A floor plan for a unit. The image upload arrives with GCS uploads (A4).
model FloorPlan {
  id         String   @id @default(uuid()) @db.Uuid
  unitId     String   @map("unit_id") @db.Uuid
  name       String // "Main floor", unique within the unit
  squareFeet Int?     @map("square_feet")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, name])
  @@map("floor_plans")
}

/// Server-side sessions, owned by connect-pg-simple (express-session store).
/// Declared here so Prisma migrations create it and never try to drop it.
/// Do not query or change this table from application code.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// ---------------------------------------------------------------------------
// Roommate groups (roadmap B1). Logic lives in src/services/group.service.js.
// ---------------------------------------------------------------------------

/// ACTIVE: normal. DISBANDED: the sole owner left; hidden from everyone but admins.
enum GroupStatus {
  ACTIVE
  DISBANDED
}

/// An invitation is tied to an EMAIL, so people can be invited before they register.
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum GroupEventType {
  CREATED
  INVITED
  INVITE_CANCELLED
  INVITE_ACCEPTED
  INVITE_DECLINED
  OWNERSHIP_TRANSFERRED
  MEMBER_LEFT
  DISBANDED
}

/// A roommate group for one term (e.g. FALL-2027).
model RoommateGroup {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  term      String // "FALL-2027", validated by zod
  ownerId   String      @map("owner_id") @db.Uuid
  status    GroupStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  owner         User              @relation(fields: [ownerId], references: [id])
  members       GroupMember[]
  invitations   GroupInvitation[]
  events        GroupEvent[]
  costEstimates CostEstimate[]
  applications  Application[]

  @@index([term])
  @@map("roommate_groups")
}

/// Accepted members only. The row is DELETED when a member leaves
/// (history stays in group_events).
model GroupMember {
  id       String   @id @default(uuid()) @db.Uuid
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  /// Copied from the group so the database itself can enforce
  /// "one group per student per term" with the unique index below.
  term     String
  joinedAt DateTime @default(now()) @map("joined_at")

  group RoommateGroup @relation(fields: [groupId], references: [id])
  user  User          @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@unique([userId, term])
  @@map("group_members")
}

/// Pending/answered invitations, matched to accounts by email when read.
/// One row per (group, email): re-inviting resets the row to PENDING.
model GroupInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  groupId     String           @map("group_id") @db.Uuid
  email       String // lowercased
  status      InvitationStatus @default(PENDING)
  invitedById String           @map("invited_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  respondedAt DateTime?        @map("responded_at")

  group     RoommateGroup @relation(fields: [groupId], references: [id])
  invitedBy User          @relation(fields: [invitedById], references: [id])

  @@unique([groupId, email])
  @@index([email, status])
  @@map("group_invitations")
}

/// Append-only audit log: who did what to a group, and when.
model GroupEvent {
  id        String         @id @default(uuid()) @db.Uuid
  groupId   String         @map("group_id") @db.Uuid
  actorId   String         @map("actor_id") @db.Uuid
  type      GroupEventType
  detail    Json? // e.g. { "email": "..." } or { "fromUserId": "...", "toUserId": "..." }
  createdAt DateTime       @default(now()) @map("created_at")

  group RoommateGroup @relation(fields: [groupId], references: [id])
  actor User          @relation(fields: [actorId], references: [id])

  @@index([groupId, createdAt])
  @@map("group_events")
}

// ---------------------------------------------------------------------------
// Cost calculator (roadmap B2). Math lives in src/services/cost.service.js;
// results are computed on every read, never stored.
// ---------------------------------------------------------------------------

/// A student's saved cost estimate. All money is integer cents.
/// CHECK constraints (people 1–16, cents >= 0, lease_months 1–24, quarters 1–4)
/// are added in the migration SQL, since Prisma's schema can't express them.
model CostEstimate {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @map("user_id") @db.Uuid
  name                   String
  people                 Int // 1–16, same limit as MAX_GROUP_SEATS
  rentCents              Int      @map("rent_cents") // per month, whole unit
  utilitiesCents         Int      @map("utilities_cents") // per month
  parkingCents           Int      @map("parking_cents") // per month
  leaseMonths            Int      @default(12) @map("lease_months")
  onCampusQuarterlyCents Int?     @map("on_campus_quarterly_cents") // per person, per quarter
  quarters               Int      @default(3)
  groupId                String?  @map("group_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  /// A deleted user's estimates are deleted with them.
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// If a group row is ever deleted, the estimate just loses its link.
  group RoommateGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("cost_estimates")
}

// ---------------------------------------------------------------------------
// Group applications (roadmap B3 part 2). The RULES (states, moves, who may make
// each move, the offer deadline) live in src/services/application.workflow.js;
// src/services/application.service.js applies them with locks and audit events.
// ---------------------------------------------------------------------------

/// Same values as STATES in application.workflow.js.
enum ApplicationStatus {
  SUBMITTED
  DOCS_REQUESTED
  UNDER_REVIEW
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  REJECTED
  WITHDRAWN
  /// Closed by the system when the unit is leased to another group, or this group accepts another place.
  CLOSED
}

/// Who made a move. Same values as ACTORS in application.workflow.js.
enum ApplicationActor {
  GROUP_MEMBER
  LISTING_OWNER
  SYSTEM
}

/// A roommate group's application for one unit.
/// CHECK (added in the migration SQL): an OFFERED application must have a deadline.
model Application {
  id             String            @id @default(uuid()) @db.Uuid
  groupId        String            @map("group_id") @db.Uuid
  unitId         String            @map("unit_id") @db.Uuid
  status         ApplicationStatus @default(SUBMITTED)
  /// Accepted members when the group applied (the size that was checked against the unit).
  groupSize      Int               @map("group_size")
  /// Set by "make offer"; kept afterwards so the history still shows the deadline.
  offerExpiresAt DateTime?         @map("offer_expires_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  group  RoommateGroup      @relation(fields: [groupId], references: [id])
  unit   Unit               @relation(fields: [unitId], references: [id])
  events ApplicationEvent[]

  @@index([unitId, status])
  @@index([groupId])
  @@map("applications")
}

/// Append-only audit log: every status change, who made it, and an optional comment.
model ApplicationEvent {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  /// Null for SYSTEM moves (an offer expiring).
  actorId       String?            @map("actor_id") @db.Uuid
  actorType     ApplicationActor   @map("actor_type")
  /// Null for the first event (applying).
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  comment       String?
  createdAt     DateTime           @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id])
  actor       User?       @relation(fields: [actorId], references: [id])

  @@index([applicationId, createdAt])
  @@map("application_events")
}

// ---------------------------------------------------------------------------
// In-app notifications (roadmap B6 part 1). Written in the same transaction as
// the event that causes them (src/services/notification.service.js).
// ---------------------------------------------------------------------------

/// What happened. Same values as NOTIFICATION_TYPES in notification.service.js.
enum NotificationType {
  APPLICATION_SUBMITTED
  DOCUMENTS_REQUESTED
  REVIEW_STARTED
  OFFER_MADE
  OFFER_RESCINDED
  APPLICATION_REJECTED
  DOCUMENTS_SENT
  APPLICATION_WITHDRAWN
  OFFER_DECLINED
  OFFER_ACCEPTED
  APPLICATION_CLOSED
  OFFER_EXPIRED
  GROUP_INVITE
}

/// One message for one user. Only that user can ever read it or mark it read.
/// CHECK (added in the migration SQL): link is an internal path ("/..." but never "//...").
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  /// Plain English; may contain a user's comment, so views must escape it.
  message   String
  /// A path on this site, e.g. "/applications/<id>".
  link      String
  /// Null until the user marks it read.
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}
